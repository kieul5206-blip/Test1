local function GetEggData(Object)
	if not Object then
		return nil
	end

	local Current = Object

	while Current and Current ~= workspace do
		local Normalized = NormalizeName(Current.Name)

		for Name,Data in pairs(EggData) do
			if NormalizeName(Name) == Normalized then
				return Data
			end
		end

		Current = Current.Parent
	end

	return nil
end

local function GetEggRoot(Object)
	if not Object then
		return nil
	end

	local Current = Object

	while Current and Current ~= workspace do
		if GetEggData(Current) then
			return Current
		end

		Current = Current.Parent
	end

	return nil
end

local function IsInsideInventory(Object)
	local Current = Object

	while Current and Current ~= workspace do
		local Name = NormalizeName(Current.Name)

		if Current:IsA("Backpack")
			or Name == "backpack"
			or Name == "inventory"
			or Name == "storage"
			or Name == "itemstorage" then
			return true
		end

		Current = Current.Parent
	end

	return false
end

local function HasGardenWord(Name)
	local Lower = string.lower(Name or "")

	for _,Word in ipairs(GardenWords) do
		if string.find(Lower,Word,1,true) then
			return true
		end
	end

	return false
end

local function IsGardenObject(Object)
	if not Object then
		return false
	end

	for _,Tag in ipairs(GardenTags) do
		if CollectionService:HasTag(Object,Tag) then
			return true
		end
	end

	local Attributes = {
		"IsGarden",
		"isGarden",
		"Garden",
		"garden",
		"IsPlot",
		"isPlot",
		"Plot",
		"plot",
		"IsPlayerPlot",
		"isPlayerPlot",
		"IsGardenPlot",
		"isGardenPlot"
	}

	for _,Attribute in ipairs(Attributes) do
		if Object:GetAttribute(Attribute) == true then
			return true
		end
	end

	return HasGardenWord(Object.Name)
end

local function IsInsidePlayerGarden(Object)
	local Current = Object

	while Current and Current ~= workspace do
		if IsGardenObject(Current) then
			return true
		end

		Current = Current.Parent
	end

	return false
end

local function IsUnavailable(Egg)
	local Attributes = {
		"Taken",
		"taken",
		"Claimed",
		"claimed",
		"Collected",
		"collected",
		"Picked",
		"picked",
		"Sold",
		"sold",
		"Used",
		"used",
		"Disabled",
		"disabled"
	}

	for _,Attribute in ipairs(Attributes) do
		if Egg:GetAttribute(Attribute) == true then
			return true
		end
	end

	if Egg:GetAttribute("Available") == false then
		return true
	end

	return false
end

local function IsValidMapEgg(Egg)
	if not Egg or not Egg:IsDescendantOf(workspace) then
		return false
	end

	if Player.Character and Egg:IsDescendantOf(Player.Character) then
		return false
	end

	if IsInsideInventory(Egg) then
		return false
	end

	if IsInsidePlayerGarden(Egg) then
		return false
	end

	if IsUnavailable(Egg) then
		return false
	end

	return true
end

local function GetEggPosition(Egg)
	if not Egg then
		return nil
	end

	if Egg:IsA("BasePart") then
		return Egg.Position
	end

	if Egg:IsA("Model") then
		if Egg.PrimaryPart then
			return Egg.PrimaryPart.Position
		end

		local Part = Egg:FindFirstChildWhichIsA("BasePart",true)

		if Part then
			return Part.Position
		end
	end

	local Part = Egg:FindFirstChildWhichIsA("BasePart",true)

	return Part and Part.Position
end

