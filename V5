local function RefreshTopEggs()
	if ScanBusy then
		return
	end

	ScanBusy = true
	ClearEggList()

	local Found = {}
	local Checked = {}
	local Objects = workspace:GetDescendants()

	local StartTime = os.clock()
	local MaxTime = 8
	local Index = 1
	local Total = #Objects

	while Index <= Total do
		local FrameStart = os.clock()
		local EndIndex = math.min(Index+500-1,Total)

		while Index <= EndIndex do
			local Object = Objects[Index]

			if Object then
				local Egg = GetEggRoot(Object)

				if Egg and not Checked[Egg] then
					Checked[Egg] = true

					local Data = GetEggData(Egg)

					if Data and IsValidMapEgg(Egg) then
						table.insert(Found,{
							Instance=Egg,
							Name=Egg.Name,
							Rarity=Data.Rarity,
							Value=Data.Value
						})
					end
				end
			end

			Index += 1

			if os.clock()-FrameStart >= 0.006 then
				break
			end
		end

		if os.clock()-StartTime >= MaxTime then
			break
		end

		RunService.Heartbeat:Wait()
	end

	table.sort(Found,function(A,B)
		return A.Value > B.Value
	end)

	for I=1,math.min(5,#Found) do
		local Egg=Found[I]

		local Button=Instance.new("TextButton")
		Button.Size=UDim2.new(1,0,0,43)
		Button.BackgroundColor3=Color3.fromRGB(17,19,25)
		Button.Text="#"..I.."  "..Egg.Name.."  •  "..Egg.Rarity.."  •  "..FormatValue(Egg.Value).." Luck"
		Button.TextColor3=Color3.fromRGB(202,205,214)
		Button.TextSize=10
		Button.Font=Enum.Font.GothamMedium
		Button.TextXAlignment=Enum.TextXAlignment.Left
		Button.AutoButtonColor=false
		Button.Parent=EggList

		local Padding=Instance.new("UIPadding")
		Padding.PaddingLeft=UDim.new(0,12)
		Padding.Parent=Button

		local Corner=Instance.new("UICorner")
		Corner.CornerRadius=UDim.new(0,7)
		Corner.Parent=Button

		table.insert(EggButtons,Button)

		Button.MouseButton1Click:Connect(function()
			if not IsValidMapEgg(Egg.Instance) then
				SelectedEgg=nil
				Button.BackgroundColor3=Color3.fromRGB(17,19,25)
				return
			end

			SelectedEgg=Egg.Instance

			for _,Other in ipairs(EggButtons) do
				Other.BackgroundColor3=Color3.fromRGB(17,19,25)
			end

			Button.BackgroundColor3=Color3.fromRGB(28,40,63)
		end)
	end

	EggList.Size=UDim2.new(1,0,0,math.min(5,#Found)*48)
	ScanBusy=false
end

