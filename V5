RunService.Heartbeat:Connect(function(Delta)
	if FlyingToHome and SavedPosition then
		local Root=GetRoot()

		if Root then
			local Current=Root.Position
			local Target=SavedPosition.Position
			local Offset=Target-Current
			local Distance=Offset.Magnitude

			if Distance<=2 then
				Root.CFrame=SavedPosition
				FlyingToHome=false
			else
				local Step=math.min(TPHomeSpeed*Delta,Distance)
				Root.CFrame=CFrame.new(Current+Offset.Unit*Step,Target)
			end
		else
			FlyingToHome=false
		end
	end
end)

