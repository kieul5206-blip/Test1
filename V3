--==================================================
-- NPC SYSTEM
--==================================================

local function IsNPC(model)
	if not model:IsA("Model") then
		return false
	end

	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart")

	return humanoid
		and root
		and humanoid.Health > 0
end

local function FindTargetNPC()
	local root = GetRoot()

	if not root then
		return nil
	end

	local nearest
	local nearestDistance = math.huge

	for _, model in ipairs(workspace:GetDescendants()) do
		if model:IsA("Model")
			and model.Name == SelectedTarget
			and IsNPC(model) then

			local npcRoot = model:FindFirstChild("HumanoidRootPart")

			if npcRoot then
				local distance =
					(root.Position - npcRoot.Position).Magnitude

				if distance < nearestDistance then
					nearestDistance = distance
					nearest = model
				end
			end
		end
	end

	return nearest
end

--==================================================
-- AUTO QUEST
--==================================================

local function FindQuest()
	local questFolder =
		workspace:FindFirstChild("Quests")
		or game:GetService("ReplicatedStorage"):FindFirstChild("Quests")

	if not questFolder then
		return nil
	end

	for _, quest in ipairs(questFolder:GetChildren()) do
		if quest.Name == SelectedTarget
			or quest:GetAttribute("Target") == SelectedTarget then

			return quest
		end
	end

	return nil
end

local function StartQuest()
	local quest = FindQuest()

	if not quest then
		return
	end

	-- Nếu game của bạn có BindableEvent StartQuest,
	-- script sẽ gọi nó.
	local event = quest:FindFirstChild("StartQuest")

	if event and event:IsA("BindableEvent") then
		event:Fire()
	end
end

