CreateSection(VisualPage, "ESP")

local ESPFolder = Instance.new("Folder")
ESPFolder.Name = "PepsihubESP"
ESPFolder.Parent = Gui

local function ClearESP()
    for _, object in ipairs(ESPFolder:GetChildren()) do
        object:Destroy()
    end
end

local function CreatePlayerESP(target)
    if target == Player then
        return
    end

    local character = target.Character

    if not character then
        return
    end

    if ESPFolder:FindFirstChild("P_" .. target.UserId) then
        return
    end

    local highlight = Instance.new("Highlight")
    highlight.Name = "P_" .. target.UserId
    highlight.Adornee = character
    highlight.FillColor = Color3.fromRGB(70, 140, 255)
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.65
    highlight.Parent = ESPFolder

    if PlayerNamesEnabled then
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "N_" .. target.UserId
        billboard.Adornee = character:FindFirstChild("Head")
        billboard.Size = UDim2.new(0, 150, 0, 30)
        billboard.StudsOffset = Vector3.new(0, 3, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = ESPFolder

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.Text = target.Name
        label.TextColor3 = Color3.fromRGB(255, 255, 255)
        label.TextStrokeTransparency = 0
        label.Font = Enum.Font.GothamBold
        label.TextSize = 12
        label.Parent = billboard
    end
end

local function UpdatePlayerESP()
    if not ESPEnabled then
        return
    end

    for _, target in ipairs(Players:GetPlayers()) do
        CreatePlayerESP(target)
    end
end

local function UpdateNPCESP()
    if not ESPNPCEnabled then
        return
    end

    for _, object in ipairs(workspace:GetChildren()) do
        if object:IsA("Model")
            and object ~= Player.Character
            and not Players:GetPlayerFromCharacter(object)
            and object:FindFirstChildOfClass("Humanoid") then

            local name = "NPC_" .. object:GetDebugId()

            if not ESPFolder:FindFirstChild(name) then
                local highlight = Instance.new("Highlight")
                highlight.Name = name
                highlight.Adornee = object
                highlight.FillColor = Color3.fromRGB(255, 145, 70)
                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                highlight.FillTransparency = 0.65
                highlight.Parent = ESPFolder
            end
        end
    end
end

CreateToggle(VisualPage, "ESP Player", function(state)
    ESPEnabled = state

    if not state then
        for _, object in ipairs(ESPFolder:GetChildren()) do
            if string.sub(object.Name, 1, 2) == "P_"
                or string.sub(object.Name, 1, 2) == "N_" then
                object:Destroy()
            end
        end
    end
end)

CreateToggle(VisualPage, "ESP NPC", function(state)
    ESPNPCEnabled = state

    if not state then
        for _, object in ipairs(ESPFolder:GetChildren()) do
            if string.sub(object.Name, 1, 4) == "NPC_" then
                object:Destroy()
            end
        end
    end
end)

CreateToggle(VisualPage, "Player Names", function(state)
    PlayerNamesEnabled = state

    if ESPEnabled then
        for _, object in ipairs(ESPFolder:GetChildren()) do
            if string.sub(object.Name, 1, 2) == "N_" then
                object:Destroy()
            end
        end

        UpdatePlayerESP()
    end
end)

