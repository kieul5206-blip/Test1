local function NormalizeName(name)
    return string.lower(
        tostring(name)
            :gsub("[%s_%-%[%]%(%)%.]", "")
    )
end

local function GetKnownEggName(name)
    local normalized = NormalizeName(name)

    for eggName in pairs(EggData) do
        if NormalizeName(eggName) == normalized then
            return eggName
        end
    end

    return nil
end

local function GetOwnerFromObject(object)
    if not object then
        return nil
    end

    local current = object

    while current and current ~= workspace do
        local attributes = {
            "Owner",
            "OwnerId",
            "OwnerName",
            "OwnerUserId",
            "UserId",
            "PlotOwner",
            "PlotOwnerId",
            "PlotOwnerUserId"
        }

        for _, attributeName in ipairs(attributes) do
            local value = current:GetAttribute(attributeName)

            if value ~= nil then
                if typeof(value) == "number" then
                    if value == Player.UserId then
                        return true
                    end
                elseif typeof(value) == "string" then
                    if value == Player.Name then
                        return true
                    end

                    if tonumber(value) == Player.UserId then
                        return true
                    end
                end
            end
        end

        for _, child in ipairs(current:GetChildren()) do
            if child:IsA("ObjectValue") then
                local name = string.lower(child.Name)

                if name == "owner"
                    or name == "player"
                    or name == "plotowner"
                    or name == "ownerplayer" then

                    if child.Value == Player then
                        return true
                    end

                    if child.Value
                        and child.Value:IsA("Player")
                        and child.Value.UserId == Player.UserId then
                        return true
                    end
                end
            end
        end

        current = current.Parent
    end

    return false
end

local function IsHomeName(object)
    if not object then
        return false
    end

    local name = string.lower(object.Name)

    return name:find("garden", 1, true)
        or name:find("plot", 1, true)
        or name:find("farm", 1, true)
        or name:find("home", 1, true)
        or name:find("base", 1, true)
        or name:find("yard", 1, true)
end

local function FindMyHome()
    local root = GetRoot()

    if not root then
        return nil
    end

    local bestTarget = nil
    local bestDistance = math.huge

    for _, object in ipairs(workspace:GetDescendants()) do
        if IsHomeName(object) and IsMyHomeObject(object) then
            local target = GetHomeTarget(object)

            if target then
                local distance =
                    (target.Position - root.Position).Magnitude

                if distance < bestDistance then
                    bestDistance = distance
                    bestTarget = target
                end
            end
        end
    end

    return bestTarget
end

local function StopTPHome()
    TPHome = false
    CachedHomeTarget = nil

    local root = GetRoot()

    if root then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
end

local function StartTPHome()
    CachedHomeTarget = FindMyHome()

    if not CachedHomeTarget then
        TPHome = false
        return
    end

    TPHome = true
end

local function UpdateTPHome()
    if not TPHome then
        return
    end

    local root = GetRoot()

    if not root then
        return
    end

    local target = CachedHomeTarget

    if not target or not target.Parent then
        StopTPHome()
        return
    end

    local offset = target.Position - root.Position
    local distance = offset.Magnitude

    if distance <= 12 then
        root.AssemblyLinearVelocity = Vector3.zero
        StopTPHome()
        return
    end

    root.AssemblyLinearVelocity = offset.Unit * TPHomeSpeed
end

CreateToggle(HomePage, "TP Home", function(state)
    if state then
        StartTPHome()
    else
        StopTPHome()
    end
end)

