Player.CharacterAdded:Connect(function()
    CachedHomeTarget = nil

    task.wait(0.5)

    ApplyCharacterSettings()

    if NoClip then
        SetNoClip(true)
    end
end)

--==================================================
-- PLAYER EVENTS
--==================================================

Players.PlayerAdded:Connect(function()
    task.wait(0.5)

    if ESPEnabled then
        UpdatePlayerESP()
    end
end)

Players.PlayerRemoving:Connect(function(player)
    local p = ESPFolder:FindFirstChild("P_" .. player.UserId)
    local n = ESPFolder:FindFirstChild("N_" .. player.UserId)

    if p then
        p:Destroy()
    end

    if n then
        n:Destroy()
    end
end)

--==================================================
-- MAIN LOOP
--==================================================

local LastESPUpdate = 0
local LastNPCUpdate = 0
local LastFixLag = 0

RunService.Heartbeat:Connect(function()
    local now = os.clock()

    if NoClip then
        SetNoClip(true)
    end

    if TPHome then
        UpdateTPHome()
    end

    if now - LastESPUpdate >= 0.2 then
        LastESPUpdate = now

        if ESPEnabled then
            UpdatePlayerESP()
        end
    end

    if now - LastNPCUpdate >= 0.75 then
        LastNPCUpdate = now

        if ESPNPCEnabled then
            UpdateNPCESP()
        end
    end

    if FixLag and now - LastFixLag >= 5 then
        LastFixLag = now

        for _, object in ipairs(workspace:GetDescendants()) do
            if object:IsA("ParticleEmitter")
                or object:IsA("Trail")
                or object:IsA("Beam") then
                object.Enabled = false
            end
        end

        for _, object in ipairs(Lighting:GetChildren()) do
            if object:IsA("PostEffect") then
                object.Enabled = false
            end
        end
    end
end)

