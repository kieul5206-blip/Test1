local function CreateTab(Text, Y, PageName)
	local Button = Instance.new("TextButton")
	Button.Size = UDim2.new(1, -16, 0, 44)
	Button.Position = UDim2.new(0, 8, 0, Y)
	Button.BackgroundColor3 = Color3.fromRGB(29, 29, 38)
	Button.Text = Text
	Button.TextColor3 = Color3.fromRGB(210, 210, 220)
	Button.TextSize = 14
	Button.Font = Enum.Font.GothamSemibold
	Button.BorderSizePixel = 0
	Button.AutoButtonColor = false
	Button.Parent = Sidebar

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0, 9)
	Corner.Parent = Button

	TabButtons[PageName] = Button

	Button.Activated:Connect(function()
		for Name, Page in pairs(Pages) do
			Page.Visible = (Name == PageName)

			if TabButtons[Name] then
				if Name == PageName then
					TabButtons[Name].BackgroundColor3 = Color3.fromRGB(65, 105, 180)
				else
					TabButtons[Name].BackgroundColor3 = Color3.fromRGB(29, 29, 38)
				end
			end
		end
	end)

	return Button
end

