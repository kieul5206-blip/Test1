local function CreateToggle(Page, Text, Y, Callback)
	local Button = Instance.new("TextButton")
	Button.Size = UDim2.new(1, -5, 0, 46)
	Button.Position = UDim2.new(0, 0, 0, Y)
	Button.BackgroundColor3 = Color3.fromRGB(29, 29, 39)
	Button.Text = ""
	Button.AutoButtonColor = false
	Button.BorderSizePixel = 0
	Button.Parent = Page

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0, 10)
	Corner.Parent = Button

	local Label = Instance.new("TextLabel")
	Label.Size = UDim2.new(1, -75, 1, 0)
	Label.Position = UDim2.new(0, 14, 0, 0)
	Label.BackgroundTransparency = 1
	Label.Text = Text
	Label.TextColor3 = Color3.fromRGB(235, 235, 240)
	Label.TextSize = 14
	Label.Font = Enum.Font.GothamSemibold
	Label.TextXAlignment = Enum.TextXAlignment.Left
	Label.Parent = Button

	local Switch = Instance.new("Frame")
	Switch.Size = UDim2.new(0, 46, 0, 24)
	Switch.Position = UDim2.new(1, -58, 0.5, -12)
	Switch.BackgroundColor3 = Color3.fromRGB(55, 55, 67)
	Switch.BorderSizePixel = 0
	Switch.Parent = Button

	local SwitchCorner = Instance.new("UICorner")
	SwitchCorner.CornerRadius = UDim.new(1, 0)
	SwitchCorner.Parent = Switch

	local Dot = Instance.new("Frame")
	Dot.Size = UDim2.new(0, 18, 0, 18)
	Dot.Position = UDim2.new(0, 3, 0.5, -9)
	Dot.BackgroundColor3 = Color3.fromRGB(230, 230, 235)
	Dot.BorderSizePixel = 0
	Dot.Parent = Switch

	local DotCorner = Instance.new("UICorner")
	DotCorner.CornerRadius = UDim.new(1, 0)
	DotCorner.Parent = Dot

	local Enabled = false

	local function SetState(State)
		Enabled = State

		local SwitchColor
		local DotPosition

		if Enabled then
			SwitchColor = Color3.fromRGB(75, 145, 255)
			DotPosition = UDim2.new(1, -21, 0.5, -9)
		else
			SwitchColor = Color3.fromRGB(55, 55, 67)
			DotPosition = UDim2.new(0, 3, 0.5, -9)
		end

		TweenService:Create(
			Switch,
			TweenInfo.new(0.15),
			{BackgroundColor3 = SwitchColor}
		):Play()

		TweenService:Create(
			Dot,
			TweenInfo.new(0.15),
			{Position = DotPosition}
		):Play()

		if Callback then
			Callback(Enabled)
		end
	end

	Button.Activated:Connect(function()
		SetState(not Enabled)
	end)

	return SetState
end

