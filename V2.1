local function CreateTab(Name, Y)
	local Button = Instance.new("TextButton")
	Button.Size = UDim2.new(1, -20, 0, 42)
	Button.Position = UDim2.new(0, 10, 0, Y)
	Button.BackgroundColor3 = Color3.fromRGB(17, 18, 25)
	Button.Text = Name
	Button.TextColor3 = Color3.fromRGB(165, 170, 185)
	Button.TextSize = 13
	Button.Font = Enum.Font.GothamSemibold
	Button.TextXAlignment = Enum.TextXAlignment.Left
	Button.AutoButtonColor = false
	Button.BorderSizePixel = 0
	Button.Parent = Sidebar

	local Padding = Instance.new("UIPadding")
	Padding.PaddingLeft = UDim.new(0, 14)
	Padding.Parent = Button

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0, 10)
	Corner.Parent = Button

	local Indicator = Instance.new("Frame")
	Indicator.Size = UDim2.new(0, 3, 0, 20)
	Indicator.Position = UDim2.new(0, 0, 0.5, -10)
	Indicator.BackgroundColor3 = Color3.fromRGB(70, 140, 255)
	Indicator.BorderSizePixel = 0
	Indicator.Visible = false
	Indicator.Parent = Button

	local IndicatorCorner = Instance.new("UICorner")
	IndicatorCorner.CornerRadius = UDim.new(1, 0)
	IndicatorCorner.Parent = Indicator

	TabButtons[Name] = Button

	Button.Activated:Connect(function()
		for TabName, Tab in pairs(TabButtons) do
			local Active = TabName == Name

			Tab.BackgroundColor3 = Active
				and Color3.fromRGB(30, 34, 48)
				or Color3.fromRGB(17, 18, 25)

			Tab.TextColor3 = Active
				and Color3.fromRGB(255, 255, 255)
				or Color3.fromRGB(165, 170, 185)

			local TabIndicator = Tab:FindFirstChildOfClass("Frame")

			if TabIndicator then
				TabIndicator.Visible = Active
			end
		end

		for PageName, Page in pairs(Pages) do
			Page.Visible = PageName == Name
		end
	end)
end

