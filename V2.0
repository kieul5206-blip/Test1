local Pages = {}
local TabButtons = {}

local function CreatePage(PageName)
	local Page = Instance.new("ScrollingFrame")
	Page.Name = PageName
	Page.Size = UDim2.new(1, 0, 1, 0)
	Page.BackgroundTransparency = 1
	Page.BorderSizePixel = 0
	Page.ScrollBarThickness = 4
	Page.ScrollBarImageTransparency = 0.35
	Page.CanvasSize = UDim2.new(0, 0, 0, 430)
	Page.ScrollingDirection = Enum.ScrollingDirection.Y
	Page.Visible = false
	Page.Parent = Content

	Pages[PageName] = Page

	local Header = Instance.new("TextLabel")
	Header.Size = UDim2.new(1, -8, 0, 32)
	Header.BackgroundTransparency = 1
	Header.Text = PageName
	Header.TextColor3 = Color3.fromRGB(255, 255, 255)
	Header.TextSize = 22
	Header.Font = Enum.Font.GothamBold
	Header.TextXAlignment = Enum.TextXAlignment.Left
	Header.Parent = Page

	return Page
end

local HomePage = CreatePage("Home")
local PlayerPage = CreatePage("Player")
local VisualPage = CreatePage("Visual")
local SettingsPage = CreatePage("Settings")

local function AddInfo(Page, Text, Y)
	local Card = Instance.new("Frame")
	Card.Size = UDim2.new(1, 0, 0, 38)
	Card.Position = UDim2.new(0, 0, 0, Y)
	Card.BackgroundColor3 = Color3.fromRGB(20, 22, 30)
	Card.BorderSizePixel = 0
	Card.Parent = Page

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0, 9)
	Corner.Parent = Card

	local Label = Instance.new("TextLabel")
	Label.Size = UDim2.new(1, -24, 1, 0)
	Label.Position = UDim2.new(0, 12, 0, 0)
	Label.BackgroundTransparency = 1
	Label.Text = Text
	Label.TextColor3 = Color3.fromRGB(185, 190, 205)
	Label.TextSize = 13
	Label.Font = Enum.Font.Gotham
	Label.TextXAlignment = Enum.TextXAlignment.Left
	Label.Parent = Card
end

AddInfo(HomePage, "Welcome to Pepsihub", 45)
AddInfo(HomePage, "Select a category from the sidebar.", 89)
AddInfo(HomePage, "Mobile and PC supported.", 133)

local function CreateToggle(Page, Text, Y, Callback)
	local Button = Instance.new("TextButton")
	Button.Size = UDim2.new(1, 0, 0, 48)
	Button.Position = UDim2.new(0, 0, 0, Y)
	Button.BackgroundColor3 = Color3.fromRGB(22, 24, 33)
	Button.Text = ""
	Button.AutoButtonColor = false
	Button.BorderSizePixel = 0
	Button.Parent = Page

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0, 11)
	Corner.Parent = Button

	local Stroke = Instance.new("UIStroke")
	Stroke.Color = Color3.fromRGB(42, 45, 58)
	Stroke.Thickness = 1
	Stroke.Transparency = 0.35
	Stroke.Parent = Button

	local Label = Instance.new("TextLabel")
	Label.Size = UDim2.new(1, -90, 1, 0)
	Label.Position = UDim2.new(0, 15, 0, 0)
	Label.BackgroundTransparency = 1
	Label.Text = Text
	Label.TextColor3 = Color3.fromRGB(235, 237, 242)
	Label.TextSize = 14
	Label.Font = Enum.Font.GothamSemibold
	Label.TextXAlignment = Enum.TextXAlignment.Left
	Label.Parent = Button

	local Switch = Instance.new("Frame")
	Switch.Size = UDim2.new(0, 48, 0, 26)
	Switch.Position = UDim2.new(1, -63, 0.5, -13)
	Switch.BackgroundColor3 = Color3.fromRGB(48, 51, 64)
	Switch.BorderSizePixel = 0
	Switch.Parent = Button

	local SwitchCorner = Instance.new("UICorner")
	SwitchCorner.CornerRadius = UDim.new(1, 0)
	SwitchCorner.Parent = Switch

	local Dot = Instance.new("Frame")
	Dot.Size = UDim2.new(0, 20, 0, 20)
	Dot.Position = UDim2.new(0, 3, 0.5, -10)
	Dot.BackgroundColor3 = Color3.fromRGB(220, 222, 230)
	Dot.BorderSizePixel = 0
	Dot.Parent = Switch

	local DotCorner = Instance.new("UICorner")
	DotCorner.CornerRadius = UDim.new(1, 0)
	DotCorner.Parent = Dot

	local Enabled = false

	local function SetState(State)
		Enabled = State

		if State then
			TweenService:Create(
				Switch,
				TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{BackgroundColor3 = Color3.fromRGB(70, 140, 255)}
			):Play()

			TweenService:Create(
				Dot,
				TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{Position = UDim2.new(1, -23, 0.5, -10)}
			):Play()
		else
			TweenService:Create(
				Switch,
				TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{BackgroundColor3 = Color3.fromRGB(48, 51, 64)}
			):Play()

			TweenService:Create(
				Dot,
				TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{Position = UDim2.new(0, 3, 0.5, -10)}
			):Play()
		end

		if Callback then
			Callback(State)
		end
	end

	Button.MouseEnter:Connect(function()
		if not Enabled then
			TweenService:Create(
				Button,
				TweenInfo.new(0.12),
				{BackgroundColor3 = Color3.fromRGB(27, 29, 40)}
			):Play()
		end
	end)

	Button.MouseLeave:Connect(function()
		if not Enabled then
			TweenService:Create(
				Button,
				TweenInfo.new(0.12),
				{BackgroundColor3 = Color3.fromRGB(22, 24, 33)}
		
